<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="ColorBackground">#FFF6F7F9</Color>
  <Color x:Key="ColorSurface">#FFFFFFFF</Color>
  <Color x:Key="ColorBorder">#FFE4E7EC</Color>
  <Color x:Key="ColorTextPrimary">#FF111827</Color>
  <Color x:Key="ColorTextSecondary">#FF6B7280</Color>
  <Color x:Key="ColorTextTertiary">#FF9CA3AF</Color>

  <Color x:Key="ColorPrimary">#FF2563EB</Color>
  <Color x:Key="ColorPrimaryDark">#FF1D4ED8</Color>
  <Color x:Key="ColorDanger">#FFDC2626</Color>
  <Color x:Key="ColorDangerDark">#FFB91C1C</Color>
  <Color x:Key="ColorNeutral">#FFF3F4F6</Color>
  <Color x:Key="ColorNeutralDark">#FFD1D5DB</Color>

  <Color x:Key="ColorChipIdle">#FFE5E7EB</Color>
  <Color x:Key="ColorChipIdleBorder">#FFD1D5DB</Color>
  <Color x:Key="ColorChipIdleDot">#FF9CA3AF</Color>
  <Color x:Key="ColorChipRunning">#FFE8F5E9</Color>
  <Color x:Key="ColorChipRunningBorder">#FFB7E1C1</Color>
  <Color x:Key="ColorChipRunningDot">#FF34D399</Color>
  <Color x:Key="ColorChipPaused">#FFFFF7E6</Color>
  <Color x:Key="ColorChipPausedBorder">#FFF6D38B</Color>
  <Color x:Key="ColorChipPausedDot">#FFF59E0B</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource ColorBackground}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource ColorTextTertiary}" />

  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorPrimary}" />
  <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource ColorPrimaryDark}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}" />
  <SolidColorBrush x:Key="DangerDarkBrush" Color="{StaticResource ColorDangerDark}" />
  <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource ColorNeutral}" />
  <SolidColorBrush x:Key="NeutralDarkBrush" Color="{StaticResource ColorNeutralDark}" />

  <SolidColorBrush x:Key="ChipIdleBrush" Color="{StaticResource ColorChipIdle}" />
  <SolidColorBrush x:Key="ChipIdleBorderBrush" Color="{StaticResource ColorChipIdleBorder}" />
  <SolidColorBrush x:Key="ChipIdleDotBrush" Color="{StaticResource ColorChipIdleDot}" />
  <SolidColorBrush x:Key="ChipRunningBrush" Color="{StaticResource ColorChipRunning}" />
  <SolidColorBrush x:Key="ChipRunningBorderBrush" Color="{StaticResource ColorChipRunningBorder}" />
  <SolidColorBrush x:Key="ChipRunningDotBrush" Color="{StaticResource ColorChipRunningDot}" />
  <SolidColorBrush x:Key="ChipPausedBrush" Color="{StaticResource ColorChipPaused}" />
  <SolidColorBrush x:Key="ChipPausedBorderBrush" Color="{StaticResource ColorChipPausedBorder}" />
  <SolidColorBrush x:Key="ChipPausedDotBrush" Color="{StaticResource ColorChipPausedDot}" />
</ResourceDictionary>
