<Window x:Class="AkteTimer.Views.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AkteTimer.Converters"
        Title="Auswertung" Height="720" Width="980">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:PositiveNegativeBrushConverter x:Key="PositiveNegativeBrushConverter" />
    <Style x:Key="ToggleCheckBoxStyle" TargetType="CheckBox">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="False">
          <Setter Property="Opacity" Value="0.4" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="EffectivityTextStyle" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Foreground" Value="{Binding EffektivitätMatter, Converter={StaticResource PositiveNegativeBrushConverter}}" />
    </Style>
    <Style x:Key="RvgTooltipTextStyle" TargetType="TextBlock">
      <Setter Property="ToolTip" Value="{Binding RvgFormulaTooltip}" />
    </Style>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <GroupBox Header="Filter" Grid.Row="0" Margin="0,0,0,8">
      <Grid Margin="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
            <TextBlock Text="Von" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker SelectedDate="{Binding FromDate}" Margin="0,0,16,0" />
            <TextBlock Text="Bis" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker SelectedDate="{Binding ToDate}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" />
            <Button Content="Export Excel" Command="{Binding ExportExcelCommand}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Akten" FontWeight="Bold" Margin="0,0,0,4" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" Height="80">
            <ItemsControl ItemsSource="{Binding MatterFilters}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding DisplayName}"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            Margin="0,0,12,4" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Grid>
    </GroupBox>

    <TabControl Grid.Row="1">
      <TabItem Header="Heute">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock FontWeight="Bold"
                       Text="{Binding TodayTotalDuration, StringFormat=Summe Ist: {0}}" />
            <TextBlock FontWeight="Bold"
                       Text="{Binding TodayTotalMinutes, StringFormat=Summe Ist-Minuten: {0}}" />
            <TextBlock FontWeight="Bold"
                       Text="{Binding TodayTotalRoundedMinutes, StringFormat=Summe 6-Min: {0}}" />
          </StackPanel>
          <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding TodayEntries}" IsReadOnly="False" MouseDoubleClick="OnEntryDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Start" Binding="{Binding StartLocal, StringFormat=HH:mm:ss}" />
              <DataGridTextColumn Header="Ende" Binding="{Binding EndLocal, StringFormat=HH:mm:ss}" />
              <DataGridTextColumn Header="Akte" Binding="{Binding Matter}" />
              <DataGridTextColumn Header="Hashtag" Binding="{Binding Hashtag}" />
              <DataGridTextColumn Header="Dauer" Binding="{Binding DurationText}" />
              <DataGridTextColumn Header="Ist-Min" Binding="{Binding ActualMinutes}" />
              <DataGridTextColumn Header="6-Min" Binding="{Binding RoundedMinutes}" />
              <DataGridTextColumn Header="Einzel-Honorar" Binding="{Binding EinzelHonorar, StringFormat=N2}" IsReadOnly="True" />
              <DataGridTextColumn Header="Stundensatz" Binding="{Binding HourlyRate, UpdateSourceTrigger=LostFocus, StringFormat=N2}" />
              <DataGridTextColumn Header="Honorar Stunden" Binding="{Binding HonorarStundenMatter, StringFormat=N2}" IsReadOnly="True" />
              <DataGridTextColumn Header="Honorar RVG"
                                  Binding="{Binding HonorarRvgMatter, StringFormat=N2}"
                                  ElementStyle="{StaticResource RvgTooltipTextStyle}"
                                  IsReadOnly="True" />
              <DataGridTextColumn Header="Streitwert" Binding="{Binding SubjectValueEur, UpdateSourceTrigger=LostFocus, StringFormat=N2}" />
              <DataGridTextColumn Header="Gebühr (wahl)" Binding="{Binding FeeFactor, UpdateSourceTrigger=LostFocus, StringFormat=F1}" />
              <DataGridCheckBoxColumn Header="Geschäftsgebühr 1,3"
                                      Binding="{Binding BusinessFee13Enabled, UpdateSourceTrigger=PropertyChanged}"
                                      ElementStyle="{StaticResource ToggleCheckBoxStyle}"
                                      EditingElementStyle="{StaticResource ToggleCheckBoxStyle}" />
              <DataGridCheckBoxColumn Header="Terminsgebühr 1,2"
                                      Binding="{Binding TermFee12Enabled, UpdateSourceTrigger=PropertyChanged}"
                                      ElementStyle="{StaticResource ToggleCheckBoxStyle}"
                                      EditingElementStyle="{StaticResource ToggleCheckBoxStyle}" />
              <DataGridCheckBoxColumn Header="Vergleichsgebühr 1,0"
                                      Binding="{Binding SettlementFee10Enabled, UpdateSourceTrigger=PropertyChanged}"
                                      ElementStyle="{StaticResource ToggleCheckBoxStyle}"
                                      EditingElementStyle="{StaticResource ToggleCheckBoxStyle}" />
              <DataGridCheckBoxColumn Header="Vergleichsgebühr 1,5"
                                      Binding="{Binding SettlementFee15Enabled, UpdateSourceTrigger=PropertyChanged}"
                                      ElementStyle="{StaticResource ToggleCheckBoxStyle}"
                                      EditingElementStyle="{StaticResource ToggleCheckBoxStyle}" />
              <DataGridTextColumn Header="Effektivität"
                                  Binding="{Binding EffektivitätMatter, StringFormat=N2}"
                                  ElementStyle="{StaticResource EffectivityTextStyle}"
                                  IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Zeitraum">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock FontWeight="Bold"
                       Text="{Binding RangeTotalDuration, StringFormat=Summe Ist: {0}}" />
            <TextBlock FontWeight="Bold"
                       Text="{Binding RangeTotalMinutes, StringFormat=Summe Ist-Minuten: {0}}" />
            <TextBlock FontWeight="Bold"
                       Text="{Binding RangeTotalRoundedMinutes, StringFormat=Summe 6-Min: {0}}" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding RangeGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,12">
                    <TextBlock FontWeight="Bold" Text="{Binding DateText, StringFormat=Tag: {0}}" />
                    <TextBlock Text="{Binding TotalDurationText, StringFormat=Summe Ist: {0}}" />
                    <TextBlock Text="{Binding TotalActualMinutes, StringFormat=Summe Ist-Minuten: {0}}" />
                    <TextBlock Text="{Binding TotalRoundedMinutes, StringFormat=Summe 6-Min: {0}}" />
                    <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Entries}" IsReadOnly="False" Margin="0,6,0,0" MouseDoubleClick="OnEntryDoubleClick">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Start" Binding="{Binding StartLocal, StringFormat=HH:mm:ss}" />
                        <DataGridTextColumn Header="Ende" Binding="{Binding EndLocal, StringFormat=HH:mm:ss}" />
                        <DataGridTextColumn Header="Akte" Binding="{Binding Matter}" />
                        <DataGridTextColumn Header="Hashtag" Binding="{Binding Hashtag}" />
                        <DataGridTextColumn Header="Dauer" Binding="{Binding DurationText}" />
                        <DataGridTextColumn Header="Ist-Min" Binding="{Binding ActualMinutes}" />
                        <DataGridTextColumn Header="6-Min" Binding="{Binding RoundedMinutes}" />
                        <DataGridTextColumn Header="Einzel-Honorar" Binding="{Binding EinzelHonorar, StringFormat=N2}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Stundensatz" Binding="{Binding HourlyRate, UpdateSourceTrigger=LostFocus, StringFormat=N2}" />
                        <DataGridTextColumn Header="Honorar Stunden" Binding="{Binding HonorarStundenMatter, StringFormat=N2}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Honorar RVG"
                                            Binding="{Binding HonorarRvgMatter, StringFormat=N2}"
                                            ElementStyle="{StaticResource RvgTooltipTextStyle}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="Streitwert" Binding="{Binding SubjectValueEur, UpdateSourceTrigger=LostFocus, StringFormat=N2}" />
                        <DataGridTextColumn Header="Gebühr (wahl)" Binding="{Binding FeeFactor, UpdateSourceTrigger=LostFocus, StringFormat=F1}" />
                        <DataGridCheckBoxColumn Header="Geschäftsgebühr 1,3"
                                                Binding="{Binding BusinessFee13Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource ToggleCheckBoxStyle}"
                                                EditingElementStyle="{StaticResource ToggleCheckBoxStyle}" />
                        <DataGridCheckBoxColumn Header="Terminsgebühr 1,2"
                                                Binding="{Binding TermFee12Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource ToggleCheckBoxStyle}"
                                                EditingElementStyle="{StaticResource ToggleCheckBoxStyle}" />
                        <DataGridCheckBoxColumn Header="Vergleichsgebühr 1,0"
                                                Binding="{Binding SettlementFee10Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource ToggleCheckBoxStyle}"
                                                EditingElementStyle="{StaticResource ToggleCheckBoxStyle}" />
                        <DataGridCheckBoxColumn Header="Vergleichsgebühr 1,5"
                                                Binding="{Binding SettlementFee15Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource ToggleCheckBoxStyle}"
                                                EditingElementStyle="{StaticResource ToggleCheckBoxStyle}" />
                        <DataGridTextColumn Header="Effektivität"
                                            Binding="{Binding EffektivitätMatter, StringFormat=N2}"
                                            ElementStyle="{StaticResource EffectivityTextStyle}"
                                            IsReadOnly="True" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="Akte">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock FontWeight="Bold"
                       Text="{Binding MatterTotalDuration, StringFormat=Summe Ist: {0}}" />
            <TextBlock FontWeight="Bold"
                       Text="{Binding MatterTotalMinutes, StringFormat=Summe Ist-Minuten: {0}}" />
            <TextBlock FontWeight="Bold"
                       Text="{Binding MatterTotalRoundedMinutes, StringFormat=Summe 6-Min: {0}}" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding MatterGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,12">
                    <TextBlock FontWeight="Bold" Text="{Binding Matter, StringFormat=Akte: {0}}" />
                    <TextBlock Text="{Binding TotalDurationText, StringFormat=Summe Ist: {0}}" />
                    <TextBlock Text="{Binding TotalActualMinutes, StringFormat=Summe Ist-Minuten: {0}}" />
                    <TextBlock Text="{Binding TotalRoundedMinutes, StringFormat=Summe 6-Min: {0}}" />
                    <StackPanel Margin="0,4,0,0" Visibility="{Binding ShowRvgMetrics, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="{Binding RvgEstimateText, StringFormat=RVG-Schätzung: {0} €}" />
                      <TextBlock Text="{Binding EffectiveHourlyRateText, StringFormat=Effektiver Stundensatz: {0} €/h}" />
                      <TextBlock Text="{Binding BreakEvenTimeText, StringFormat=Break-even-Zeit: {0}}" />
                    </StackPanel>
                    <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Entries}" IsReadOnly="False" Margin="0,6,0,0" MouseDoubleClick="OnEntryDoubleClick">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Start" Binding="{Binding StartLocal, StringFormat=dd.MM.yyyy HH:mm:ss}" />
                        <DataGridTextColumn Header="Ende" Binding="{Binding EndLocal, StringFormat=dd.MM.yyyy HH:mm:ss}" />
                        <DataGridTextColumn Header="Hashtag" Binding="{Binding Hashtag}" />
                        <DataGridTextColumn Header="Dauer" Binding="{Binding DurationText}" />
                        <DataGridTextColumn Header="Ist-Min" Binding="{Binding ActualMinutes}" />
                        <DataGridTextColumn Header="6-Min" Binding="{Binding RoundedMinutes}" />
                        <DataGridTextColumn Header="Einzel-Honorar" Binding="{Binding EinzelHonorar, StringFormat=N2}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Stundensatz" Binding="{Binding HourlyRate, UpdateSourceTrigger=LostFocus, StringFormat=N2}" />
                        <DataGridTextColumn Header="Honorar Stunden" Binding="{Binding HonorarStundenMatter, StringFormat=N2}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Honorar RVG"
                                            Binding="{Binding HonorarRvgMatter, StringFormat=N2}"
                                            ElementStyle="{StaticResource RvgTooltipTextStyle}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="Streitwert" Binding="{Binding SubjectValueEur, UpdateSourceTrigger=LostFocus, StringFormat=N2}" />
                        <DataGridTextColumn Header="Gebühr (wahl)" Binding="{Binding FeeFactor, UpdateSourceTrigger=LostFocus, StringFormat=F1}" />
                        <DataGridCheckBoxColumn Header="Geschäftsgebühr 1,3"
                                                Binding="{Binding BusinessFee13Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource ToggleCheckBoxStyle}"
                                                EditingElementStyle="{StaticResource ToggleCheckBoxStyle}" />
                        <DataGridCheckBoxColumn Header="Terminsgebühr 1,2"
                                                Binding="{Binding TermFee12Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource ToggleCheckBoxStyle}"
                                                EditingElementStyle="{StaticResource ToggleCheckBoxStyle}" />
                        <DataGridCheckBoxColumn Header="Vergleichsgebühr 1,0"
                                                Binding="{Binding SettlementFee10Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource ToggleCheckBoxStyle}"
                                                EditingElementStyle="{StaticResource ToggleCheckBoxStyle}" />
                        <DataGridCheckBoxColumn Header="Vergleichsgebühr 1,5"
                                                Binding="{Binding SettlementFee15Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource ToggleCheckBoxStyle}"
                                                EditingElementStyle="{StaticResource ToggleCheckBoxStyle}" />
                        <DataGridTextColumn Header="Effektivität"
                                            Binding="{Binding EffektivitätMatter, StringFormat=N2}"
                                            ElementStyle="{StaticResource EffectivityTextStyle}"
                                            IsReadOnly="True" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
      <TabItem Header="Akte-Details">
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ListBox ItemsSource="{Binding MatterDetails}"
                   SelectedItem="{Binding SelectedMatterDetails}"
                   DisplayMemberPath="FileRef" />
          <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock FontWeight="Bold" FontSize="14"
                         Text="{Binding SelectedMatterDetails.FileRef, StringFormat=Akte: {0}}" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Abrechnungstyp" Width="140" VerticalAlignment="Center" />
                <ComboBox Width="160"
                          ItemsSource="{Binding DataContext.BillingTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding SelectedMatterDetails.BillingType, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Visibility="{Binding SelectedMatterDetails.ShowRvgFields, Converter={StaticResource BoolToVis}}">
                <TextBlock Margin="0,10,0,6"
                           Foreground="DarkRed"
                           Text="RVG-Schätzung für internes Controlling – keine Abrechnung und keine Kostenfestsetzung." />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock Text="Streitwert (EUR)" Width="180" VerticalAlignment="Center" />
                  <TextBox Width="140"
                           Text="{Binding SelectedMatterDetails.SubjectValueEur, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock Text="Gebührensatz/Faktor" Width="180" VerticalAlignment="Center" />
                  <TextBox Width="140"
                           Text="{Binding SelectedMatterDetails.FeeFactor, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock Text="Stundensatz (EUR/h)" Width="180" VerticalAlignment="Center" />
                  <TextBox Width="140"
                           Text="{Binding SelectedMatterDetails.HourlyRateEurPerHour, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Separator Margin="0,8,0,8" />
                <TextBlock Text="{Binding SelectedMatterDetails.Fee1_0EurText, StringFormat='1,0-Gebühr: {0} €'}" />
                <TextBlock Text="{Binding SelectedMatterDetails.RvgEstimateEurText, StringFormat=RVG-Schätzung: {0} €}" />
                <TextBlock Text="{Binding SelectedMatterDetails.EffectiveHourlyRateText, StringFormat=Effektiver Stundensatz: {0} €/h}" />
                <TextBlock Text="{Binding SelectedMatterDetails.BreakEvenTimeText, StringFormat=Break-even-Zeit: {0}}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
