<Window x:Class="AkteTimer.Views.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auswertung" Height="720" Width="980">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <GroupBox Header="Filter" Grid.Row="0" Margin="0,0,0,8">
      <Grid Margin="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
            <TextBlock Text="Von" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker SelectedDate="{Binding FromDate}" Margin="0,0,16,0" />
            <TextBlock Text="Bis" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker SelectedDate="{Binding ToDate}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" />
            <Button Content="Export Excel" Command="{Binding ExportExcelCommand}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Akten" FontWeight="Bold" Margin="0,0,0,4" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" Height="80">
            <ItemsControl ItemsSource="{Binding MatterFilters}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding DisplayName}"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            Margin="0,0,12,4" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Grid>
    </GroupBox>

    <TabControl Grid.Row="1">
      <TabItem Header="Heute">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock FontWeight="Bold"
                       Text="{Binding TodayTotalDuration, StringFormat=Summe Ist: {0}}" />
            <TextBlock FontWeight="Bold"
                       Text="{Binding TodayTotalMinutes, StringFormat=Summe Ist-Minuten: {0}}" />
            <TextBlock FontWeight="Bold"
                       Text="{Binding TodayTotalRoundedMinutes, StringFormat=Summe 6-Min: {0}}" />
          </StackPanel>
          <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding TodayEntries}" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Start" Binding="{Binding StartLocal, StringFormat=HH:mm:ss}" />
              <DataGridTextColumn Header="Ende" Binding="{Binding EndLocal, StringFormat=HH:mm:ss}" />
              <DataGridTextColumn Header="Akte" Binding="{Binding Matter}" />
              <DataGridTextColumn Header="Hashtag" Binding="{Binding Hashtag}" />
              <DataGridTextColumn Header="Dauer" Binding="{Binding DurationText}" />
              <DataGridTextColumn Header="Ist-Min" Binding="{Binding ActualMinutes}" />
              <DataGridTextColumn Header="6-Min" Binding="{Binding RoundedMinutes}" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Zeitraum">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock FontWeight="Bold"
                       Text="{Binding RangeTotalDuration, StringFormat=Summe Ist: {0}}" />
            <TextBlock FontWeight="Bold"
                       Text="{Binding RangeTotalMinutes, StringFormat=Summe Ist-Minuten: {0}}" />
            <TextBlock FontWeight="Bold"
                       Text="{Binding RangeTotalRoundedMinutes, StringFormat=Summe 6-Min: {0}}" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding RangeGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,12">
                    <TextBlock FontWeight="Bold" Text="{Binding DateText, StringFormat=Tag: {0}}" />
                    <TextBlock Text="{Binding TotalDurationText, StringFormat=Summe Ist: {0}}" />
                    <TextBlock Text="{Binding TotalActualMinutes, StringFormat=Summe Ist-Minuten: {0}}" />
                    <TextBlock Text="{Binding TotalRoundedMinutes, StringFormat=Summe 6-Min: {0}}" />
                    <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Entries}" IsReadOnly="True" Margin="0,6,0,0">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Start" Binding="{Binding StartLocal, StringFormat=HH:mm:ss}" />
                        <DataGridTextColumn Header="Ende" Binding="{Binding EndLocal, StringFormat=HH:mm:ss}" />
                        <DataGridTextColumn Header="Akte" Binding="{Binding Matter}" />
                        <DataGridTextColumn Header="Hashtag" Binding="{Binding Hashtag}" />
                        <DataGridTextColumn Header="Dauer" Binding="{Binding DurationText}" />
                        <DataGridTextColumn Header="Ist-Min" Binding="{Binding ActualMinutes}" />
                        <DataGridTextColumn Header="6-Min" Binding="{Binding RoundedMinutes}" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="Akte">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock FontWeight="Bold"
                       Text="{Binding MatterTotalDuration, StringFormat=Summe Ist: {0}}" />
            <TextBlock FontWeight="Bold"
                       Text="{Binding MatterTotalMinutes, StringFormat=Summe Ist-Minuten: {0}}" />
            <TextBlock FontWeight="Bold"
                       Text="{Binding MatterTotalRoundedMinutes, StringFormat=Summe 6-Min: {0}}" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding MatterGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,12">
                    <TextBlock FontWeight="Bold" Text="{Binding Matter, StringFormat=Akte: {0}}" />
                    <TextBlock Text="{Binding TotalDurationText, StringFormat=Summe Ist: {0}}" />
                    <TextBlock Text="{Binding TotalActualMinutes, StringFormat=Summe Ist-Minuten: {0}}" />
                    <TextBlock Text="{Binding TotalRoundedMinutes, StringFormat=Summe 6-Min: {0}}" />
                    <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Entries}" IsReadOnly="True" Margin="0,6,0,0">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Start" Binding="{Binding StartLocal, StringFormat=dd.MM.yyyy HH:mm:ss}" />
                        <DataGridTextColumn Header="Ende" Binding="{Binding EndLocal, StringFormat=dd.MM.yyyy HH:mm:ss}" />
                        <DataGridTextColumn Header="Hashtag" Binding="{Binding Hashtag}" />
                        <DataGridTextColumn Header="Dauer" Binding="{Binding DurationText}" />
                        <DataGridTextColumn Header="Ist-Min" Binding="{Binding ActualMinutes}" />
                        <DataGridTextColumn Header="6-Min" Binding="{Binding RoundedMinutes}" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
