<Window x:Class="AkteTimer.Views.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AkteTimer.Converters"
        Title="Auswertung" Height="720" Width="980">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:PositiveNegativeBrushConverter x:Key="PositiveNegativeBrushConverter" />
    <converters:FlexibleDecimalConverter x:Key="CurrencyConverter" Format="N2" Suffix="€" />
    <converters:FlexibleDecimalConverter x:Key="FeeFactorConverter" Format="F1" AllowNull="True" />
    <Style x:Key="ToggleCheckBoxStyle" TargetType="CheckBox">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="False">
          <Setter Property="Opacity" Value="0.4" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NumericTextBlockStyle" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style x:Key="RvgAmountTextStyle" TargetType="TextBlock" BasedOn="{StaticResource NumericTextBlockStyle}">
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style x:Key="NumericTextBoxStyle" TargetType="TextBox">
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style x:Key="SaveAwareNumericTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource NumericTextBoxStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSaving}" Value="True">
          <Setter Property="IsEnabled" Value="False" />
          <Setter Property="Opacity" Value="0.6" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SaveAwareToggleCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource ToggleCheckBoxStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSaving}" Value="True">
          <Setter Property="IsEnabled" Value="False" />
          <Setter Property="Opacity" Value="0.5" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="EffectivityTextStyle" TargetType="TextBlock" BasedOn="{StaticResource NumericTextBlockStyle}">
      <Setter Property="Foreground" Value="{Binding EffektivitätMatter, Converter={StaticResource PositiveNegativeBrushConverter}}" />
    </Style>
    <Style x:Key="RvgTooltipTextStyle" TargetType="TextBlock" BasedOn="{StaticResource NumericTextBlockStyle}">
      <Setter Property="ToolTip" Value="Gesamtakte" />
      <Setter Property="Foreground" Value="DarkGray" />
    </Style>
    <Style x:Key="NoteTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="DimGray" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="BilledRowStyle" TargetType="DataGridRow">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsBilled}" Value="True">
          <Setter Property="Foreground" Value="DimGray" />
          <Setter Property="FontStyle" Value="Italic" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BilledBadgeTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="DimGray" />
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <Style x:Key="HashtagBadgeStyle" TargetType="Border">
      <Setter Property="Background" Value="#E5E7EB" />
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="HashtagTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#374151" />
    </Style>
    <Style x:Key="DayCardStyle" TargetType="Border">
      <Setter Property="Background" Value="#F9FAFB" />
      <Setter Property="BorderBrush" Value="#E5E7EB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="DayCardTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="DimGray" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style x:Key="KpiValueStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <GroupBox Header="Filter" Grid.Row="0" Margin="0,0,0,8">
      <Grid Margin="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
            <TextBlock Text="Von" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker SelectedDate="{Binding FromDate}" Margin="0,0,16,0" />
            <TextBlock Text="Bis" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker SelectedDate="{Binding ToDate}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" />
            <Button Content="Export Excel" Command="{Binding ExportExcelCommand}" />
            <Button Content="Abrechnung (Ansicht)"
                    Command="{Binding CreateBillingDraftsFromViewCommand}"
                    Margin="16,0,0,0" />
            <Button Content="Abrechnung (offen)"
                    Command="{Binding CreateBillingDraftsFromAllOpenCommand}"
                    Margin="8,0,0,0" />
            <Button Content="Abrechnungsverfügungen erstellen"
                    Command="{Binding CreateBillingDraftsFromViewCommand}"
                    Margin="16,0,0,0" />
            <Button Content="Offene Zeiten abrechnen"
                    Command="{Binding CreateBillingDraftsFromAllOpenCommand}"
                    Margin="8,0,0,0" />
            <CheckBox Content="Beschreibung anzeigen"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center"
                      IsChecked="{Binding ShowDescription}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Akte filtern" FontWeight="Bold" Margin="0,0,0,4" />
          <StackPanel Orientation="Horizontal">
            <TextBox Width="220"
                     Margin="0,0,8,0"
                     ToolTip="Akte filtern..."
                     Text="{Binding MatterFilterSearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="260"
                      DisplayMemberPath="DisplayName"
                      IsTextSearchEnabled="True"
                      ItemsSource="{Binding MatterFilterView}"
                      SelectedItem="{Binding SelectedMatterFilter}" />
            <Button Content="Filter zurücksetzen"
                    Margin="8,0,0,0"
                    Command="{Binding ResetMatterFilterCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </GroupBox>

    <TabControl Grid.Row="1">
      <TabItem Header="Heute">
        <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding TodayGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource DayCardStyle}" Margin="0,0,0,12">
                  <StackPanel>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Style="{StaticResource DayCardTitleStyle}" Text="{Binding DateLongText}" />
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding TotalDurationText, StringFormat=Tagessumme: {0}}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <StackPanel Margin="12,0,0,0">
                          <TextBlock Style="{StaticResource KpiLabelStyle}" Text="Ist-Min" />
                          <TextBlock Style="{StaticResource KpiValueStyle}" Text="{Binding TotalActualMinutes}" />
                        </StackPanel>
                        <StackPanel Margin="12,0,0,0">
                          <TextBlock Style="{StaticResource KpiLabelStyle}" Text="6-Min" />
                          <TextBlock Style="{StaticResource KpiValueStyle}" Text="{Binding TotalRoundedMinutes}" />
                        </StackPanel>
                        <StackPanel Margin="12,0,0,0">
                          <TextBlock Style="{StaticResource KpiLabelStyle}" Text="Tageshonorar" />
                          <TextBlock Style="{StaticResource KpiValueStyle}"
                                     Text="{Binding TotalHonorarEur, Converter={StaticResource CurrencyConverter}}" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                    <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Entries}" IsReadOnly="False" MouseDoubleClick="OnEntryDoubleClick" RowStyle="{StaticResource BilledRowStyle}">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Start" Binding="{Binding StartLocal, StringFormat=HH:mm:ss}" />
                        <DataGridTextColumn Header="Ende" Binding="{Binding EndLocal, StringFormat=HH:mm:ss}" />
                        <DataGridTemplateColumn Header="Status" MinWidth="110">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Text="✓ abgerechnet"
                                         Style="{StaticResource BilledBadgeTextStyle}"
                                         Visibility="{Binding IsBilled, Converter={StaticResource BoolToVis}}" />
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Akte" Binding="{Binding Matter}" />
                        <DataGridTemplateColumn Header="Hashtag">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource HashtagBadgeStyle}">
                                <TextBlock Text="{Binding Hashtag}" Style="{StaticResource HashtagTextStyle}" />
                              </Border>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Dauer" Binding="{Binding DurationText}" />
                        <DataGridTextColumn Header="6-Minuten" Binding="{Binding RoundedMinutes}" ElementStyle="{StaticResource NumericTextBlockStyle}" />
                        <DataGridTextColumn Header="Stundensatz"
                                            Binding="{Binding HourlyRate, UpdateSourceTrigger=LostFocus, Converter={StaticResource CurrencyConverter}}"
                                            ElementStyle="{StaticResource NumericTextBlockStyle}"
                                            EditingElementStyle="{StaticResource SaveAwareNumericTextBoxStyle}" />
                        <DataGridTextColumn Header="Zeit-Honorar"
                                            Binding="{Binding HonorarStundenMatter, Converter={StaticResource CurrencyConverter}}"
                                            ElementStyle="{StaticResource NumericTextBlockStyle}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="RVG-Honorar"
                                            Binding="{Binding HonorarRvgMatter, Converter={StaticResource CurrencyConverter}}"
                                            ElementStyle="{StaticResource RvgTooltipTextStyle}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="Streitwert"
                                            Binding="{Binding SubjectValueEur, UpdateSourceTrigger=LostFocus, Converter={StaticResource CurrencyConverter}}"
                                            ElementStyle="{StaticResource NumericTextBlockStyle}"
                                            EditingElementStyle="{StaticResource SaveAwareNumericTextBoxStyle}" />
                        <DataGridTemplateColumn Header="Gebühr (wahl)">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="60" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Margin="0,0,6,0"
                                         MinWidth="50"
                                         Style="{StaticResource SaveAwareNumericTextBoxStyle}"
                                         Text="{Binding CustomFeeFactor, UpdateSourceTrigger=LostFocus, Converter={StaticResource FeeFactorConverter}}" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource NumericTextBlockStyle}"
                                           Text="{Binding CustomFeeEurText}" />
                              </Grid>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Geschäft 1,3">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource SaveAwareToggleCheckBoxStyle}"
                                          IsChecked="{Binding BusinessFee13Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding BusinessFee13EurText}">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RvgAmountTextStyle}">
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding BusinessFee13Enabled}" Value="False">
                                          <Setter Property="Foreground" Value="DarkGray" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Grid>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Termin 1,2">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource SaveAwareToggleCheckBoxStyle}"
                                          IsChecked="{Binding TermFee12Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TermFee12EurText}">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RvgAmountTextStyle}">
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding TermFee12Enabled}" Value="False">
                                          <Setter Property="Foreground" Value="DarkGray" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Grid>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Vergleich 1,0">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource SaveAwareToggleCheckBoxStyle}"
                                          IsChecked="{Binding SettlementFee10Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SettlementFee10EurText}">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RvgAmountTextStyle}">
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettlementFee10Enabled}" Value="False">
                                          <Setter Property="Foreground" Value="DarkGray" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Grid>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Vergleich 1,5">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource SaveAwareToggleCheckBoxStyle}"
                                          IsChecked="{Binding SettlementFee15Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SettlementFee15EurText}">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RvgAmountTextStyle}">
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettlementFee15Enabled}" Value="False">
                                          <Setter Property="Foreground" Value="DarkGray" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Grid>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Effektivität"
                                            Binding="{Binding EffektivitätMatter, Converter={StaticResource CurrencyConverter}}"
                                            ElementStyle="{StaticResource EffectivityTextStyle}"
                                            IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Beschreibung"
                                                Visibility="{Binding DataContext.ShowDescription, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Note}" Style="{StaticResource NoteTextStyle}" />
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                          <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                              <TextBox Text="{Binding Note, UpdateSourceTrigger=LostFocus}"
                                       MinWidth="160" />
                            </DataTemplate>
                          </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Zeitraum">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock FontWeight="Bold"
                       Text="{Binding RangeTotalDuration, StringFormat=Summe Ist: {0}}" />
            <TextBlock FontWeight="Bold"
                       Text="{Binding RangeTotalMinutes, StringFormat=Summe Ist-Minuten: {0}}" />
            <TextBlock FontWeight="Bold"
                       Text="{Binding RangeTotalRoundedMinutes, StringFormat=Summe 6-Min: {0}}" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding RangeGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource DayCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Style="{StaticResource DayCardTitleStyle}" Text="{Binding DateLongText}" />
                          <TextBlock FontWeight="SemiBold"
                                     Text="{Binding TotalDurationText, StringFormat=Tagessumme: {0}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                          <StackPanel Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource KpiLabelStyle}" Text="Ist-Min" />
                            <TextBlock Style="{StaticResource KpiValueStyle}" Text="{Binding TotalActualMinutes}" />
                          </StackPanel>
                          <StackPanel Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource KpiLabelStyle}" Text="6-Min" />
                            <TextBlock Style="{StaticResource KpiValueStyle}" Text="{Binding TotalRoundedMinutes}" />
                          </StackPanel>
                          <StackPanel Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource KpiLabelStyle}" Text="Tageshonorar" />
                            <TextBlock Style="{StaticResource KpiValueStyle}"
                                       Text="{Binding TotalHonorarEur, Converter={StaticResource CurrencyConverter}}" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                      <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Entries}" IsReadOnly="False" Margin="0,6,0,0" MouseDoubleClick="OnEntryDoubleClick" RowStyle="{StaticResource BilledRowStyle}">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Start" Binding="{Binding StartLocal, StringFormat=HH:mm:ss}" />
                        <DataGridTextColumn Header="Ende" Binding="{Binding EndLocal, StringFormat=HH:mm:ss}" />
                        <DataGridTemplateColumn Header="Status" MinWidth="110">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Text="✓ abgerechnet"
                                         Style="{StaticResource BilledBadgeTextStyle}"
                                         Visibility="{Binding IsBilled, Converter={StaticResource BoolToVis}}" />
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Akte" Binding="{Binding Matter}" />
                        <DataGridTemplateColumn Header="Hashtag">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource HashtagBadgeStyle}">
                                <TextBlock Text="{Binding Hashtag}" Style="{StaticResource HashtagTextStyle}" />
                              </Border>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Dauer" Binding="{Binding DurationText}" />
                        <DataGridTextColumn Header="6-Minuten" Binding="{Binding RoundedMinutes}" ElementStyle="{StaticResource NumericTextBlockStyle}" />
                        <DataGridTextColumn Header="Stundensatz"
                                            Binding="{Binding HourlyRate, UpdateSourceTrigger=LostFocus, Converter={StaticResource CurrencyConverter}}"
                                            ElementStyle="{StaticResource NumericTextBlockStyle}"
                                            EditingElementStyle="{StaticResource SaveAwareNumericTextBoxStyle}" />
                        <DataGridTextColumn Header="Zeit-Honorar"
                                            Binding="{Binding HonorarStundenMatter, Converter={StaticResource CurrencyConverter}}"
                                            ElementStyle="{StaticResource NumericTextBlockStyle}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="RVG-Honorar"
                                            Binding="{Binding HonorarRvgMatter, Converter={StaticResource CurrencyConverter}}"
                                            ElementStyle="{StaticResource RvgTooltipTextStyle}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="Streitwert"
                                            Binding="{Binding SubjectValueEur, UpdateSourceTrigger=LostFocus, Converter={StaticResource CurrencyConverter}}"
                                            ElementStyle="{StaticResource NumericTextBlockStyle}"
                                            EditingElementStyle="{StaticResource SaveAwareNumericTextBoxStyle}" />
                        <DataGridTemplateColumn Header="Gebühr (wahl)">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="60" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Margin="0,0,6,0"
                                         MinWidth="50"
                                         Style="{StaticResource SaveAwareNumericTextBoxStyle}"
                                         Text="{Binding CustomFeeFactor, UpdateSourceTrigger=LostFocus, Converter={StaticResource FeeFactorConverter}}" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource NumericTextBlockStyle}"
                                           Text="{Binding CustomFeeEurText}" />
                              </Grid>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Geschäft 1,3">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource SaveAwareToggleCheckBoxStyle}"
                                          IsChecked="{Binding BusinessFee13Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding BusinessFee13EurText}">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RvgAmountTextStyle}">
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding BusinessFee13Enabled}" Value="False">
                                          <Setter Property="Foreground" Value="DarkGray" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Grid>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Termin 1,2">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource SaveAwareToggleCheckBoxStyle}"
                                          IsChecked="{Binding TermFee12Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TermFee12EurText}">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RvgAmountTextStyle}">
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding TermFee12Enabled}" Value="False">
                                          <Setter Property="Foreground" Value="DarkGray" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Grid>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Vergleich 1,0">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource SaveAwareToggleCheckBoxStyle}"
                                          IsChecked="{Binding SettlementFee10Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SettlementFee10EurText}">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RvgAmountTextStyle}">
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettlementFee10Enabled}" Value="False">
                                          <Setter Property="Foreground" Value="DarkGray" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Grid>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Vergleich 1,5">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource SaveAwareToggleCheckBoxStyle}"
                                          IsChecked="{Binding SettlementFee15Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SettlementFee15EurText}">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RvgAmountTextStyle}">
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettlementFee15Enabled}" Value="False">
                                          <Setter Property="Foreground" Value="DarkGray" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Grid>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Effektivität"
                                            Binding="{Binding EffektivitätMatter, Converter={StaticResource CurrencyConverter}}"
                                            ElementStyle="{StaticResource EffectivityTextStyle}"
                                            IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Beschreibung"
                                                Visibility="{Binding DataContext.ShowDescription, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Note}" Style="{StaticResource NoteTextStyle}" />
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                          <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                              <TextBox Text="{Binding Note, UpdateSourceTrigger=LostFocus}"
                                       MinWidth="160" />
                            </DataTemplate>
                          </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="Akte">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock FontWeight="Bold"
                       Text="{Binding MatterTotalDuration, StringFormat=Summe Ist: {0}}" />
            <TextBlock FontWeight="Bold"
                       Text="{Binding MatterTotalMinutes, StringFormat=Summe Ist-Minuten: {0}}" />
            <TextBlock FontWeight="Bold"
                       Text="{Binding MatterTotalRoundedMinutes, StringFormat=Summe 6-Min: {0}}" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding MatterGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,12">
                    <TextBlock FontWeight="Bold" Text="{Binding Matter, StringFormat=Akte: {0}}" />
                    <TextBlock Text="{Binding TotalDurationText, StringFormat=Summe Ist: {0}}" />
                    <TextBlock Text="{Binding TotalActualMinutes, StringFormat=Summe Ist-Minuten: {0}}" />
                    <TextBlock Text="{Binding TotalRoundedMinutes, StringFormat=Summe 6-Min: {0}}" />
                    <StackPanel Margin="0,4,0,0" Visibility="{Binding ShowRvgMetrics, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="{Binding RvgEstimateText, StringFormat=RVG-Schätzung: {0} €}" />
                      <TextBlock Text="{Binding EffectiveHourlyRateText, StringFormat=Effektiver Stundensatz: {0} €/h}" />
                      <TextBlock Text="{Binding BreakEvenTimeText, StringFormat=Break-even-Zeit: {0}}" />
                    </StackPanel>
                    <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Entries}" IsReadOnly="False" Margin="0,6,0,0" MouseDoubleClick="OnEntryDoubleClick" RowStyle="{StaticResource BilledRowStyle}">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Start" Binding="{Binding StartLocal, StringFormat=dd.MM.yyyy HH:mm:ss}" />
                        <DataGridTextColumn Header="Ende" Binding="{Binding EndLocal, StringFormat=dd.MM.yyyy HH:mm:ss}" />
                        <DataGridTemplateColumn Header="Status" MinWidth="110">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Text="✓ abgerechnet"
                                         Style="{StaticResource BilledBadgeTextStyle}"
                                         Visibility="{Binding IsBilled, Converter={StaticResource BoolToVis}}" />
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Akte" Binding="{Binding Matter}" />
                        <DataGridTemplateColumn Header="Hashtag">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource HashtagBadgeStyle}">
                                <TextBlock Text="{Binding Hashtag}" Style="{StaticResource HashtagTextStyle}" />
                              </Border>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Dauer" Binding="{Binding DurationText}" />
                        <DataGridTextColumn Header="6-Minuten" Binding="{Binding RoundedMinutes}" ElementStyle="{StaticResource NumericTextBlockStyle}" />
                        <DataGridTextColumn Header="Stundensatz"
                                            Binding="{Binding HourlyRate, UpdateSourceTrigger=LostFocus, Converter={StaticResource CurrencyConverter}}"
                                            ElementStyle="{StaticResource NumericTextBlockStyle}"
                                            EditingElementStyle="{StaticResource SaveAwareNumericTextBoxStyle}" />
                        <DataGridTextColumn Header="Zeit-Honorar"
                                            Binding="{Binding HonorarStundenMatter, Converter={StaticResource CurrencyConverter}}"
                                            ElementStyle="{StaticResource NumericTextBlockStyle}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="RVG-Honorar"
                                            Binding="{Binding HonorarRvgMatter, Converter={StaticResource CurrencyConverter}}"
                                            ElementStyle="{StaticResource RvgTooltipTextStyle}"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="Streitwert"
                                            Binding="{Binding SubjectValueEur, UpdateSourceTrigger=LostFocus, Converter={StaticResource CurrencyConverter}}"
                                            ElementStyle="{StaticResource NumericTextBlockStyle}"
                                            EditingElementStyle="{StaticResource SaveAwareNumericTextBoxStyle}" />
                        <DataGridTemplateColumn Header="Gebühr (wahl)">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="60" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Margin="0,0,6,0"
                                         MinWidth="50"
                                         Style="{StaticResource SaveAwareNumericTextBoxStyle}"
                                         Text="{Binding CustomFeeFactor, UpdateSourceTrigger=LostFocus, Converter={StaticResource FeeFactorConverter}}" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource NumericTextBlockStyle}"
                                           Text="{Binding CustomFeeEurText}" />
                              </Grid>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Geschäft 1,3">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource SaveAwareToggleCheckBoxStyle}"
                                          IsChecked="{Binding BusinessFee13Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding BusinessFee13EurText}">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RvgAmountTextStyle}">
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding BusinessFee13Enabled}" Value="False">
                                          <Setter Property="Foreground" Value="DarkGray" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Grid>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Termin 1,2">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource SaveAwareToggleCheckBoxStyle}"
                                          IsChecked="{Binding TermFee12Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TermFee12EurText}">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RvgAmountTextStyle}">
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding TermFee12Enabled}" Value="False">
                                          <Setter Property="Foreground" Value="DarkGray" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Grid>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Vergleich 1,0">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource SaveAwareToggleCheckBoxStyle}"
                                          IsChecked="{Binding SettlementFee10Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SettlementFee10EurText}">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RvgAmountTextStyle}">
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettlementFee10Enabled}" Value="False">
                                          <Setter Property="Foreground" Value="DarkGray" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Grid>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Vergleich 1,5">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource SaveAwareToggleCheckBoxStyle}"
                                          IsChecked="{Binding SettlementFee15Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SettlementFee15EurText}">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RvgAmountTextStyle}">
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettlementFee15Enabled}" Value="False">
                                          <Setter Property="Foreground" Value="DarkGray" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Grid>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Effektivität"
                                            Binding="{Binding EffektivitätMatter, Converter={StaticResource CurrencyConverter}}"
                                            ElementStyle="{StaticResource EffectivityTextStyle}"
                                            IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Beschreibung"
                                                Visibility="{Binding DataContext.ShowDescription, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Note}" Style="{StaticResource NoteTextStyle}" />
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                          <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                              <TextBox Text="{Binding Note, UpdateSourceTrigger=LostFocus}"
                                       MinWidth="160" />
                            </DataTemplate>
                          </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="Löschung">
        <DockPanel Margin="0,8,0,0">
          <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding DeleteEntries}" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Datum" Binding="{Binding DateLocal, StringFormat=dd.MM.yyyy}" />
              <DataGridTextColumn Header="Start" Binding="{Binding StartLocal, StringFormat=HH:mm:ss}" />
              <DataGridTextColumn Header="Ende" Binding="{Binding EndText}" />
              <DataGridTextColumn Header="Akte" Binding="{Binding Matter}" />
              <DataGridTextColumn Header="Hashtag" Binding="{Binding Hashtag}" />
              <DataGridTextColumn Header="Dauer" Binding="{Binding DurationText}" />
              <DataGridTextColumn Header="Beschreibung/Note" Binding="{Binding Note}" />
              <DataGridTemplateColumn Header="Löschen">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Löschen"
                            Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="2"
               Margin="0,6,0,0"
               Foreground="DimGray"
               Text="{Binding AutoBillingHint}"
               Visibility="{Binding ShowAutoBillingHint, Converter={StaticResource BoolToVis}}" />
  </Grid>
</Window>
