<Window x:Class="AkteTimer.Views.BillingWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AkteTimer.Converters"
        Title="Abrechnung" Height="620" Width="900">
  <Window.Resources>
    <converters:FlexibleDecimalConverter x:Key="CurrencyConverter" Format="N2" Suffix="€" />
    <converters:FlexibleDecimalConverter x:Key="HoursConverter" Format="N2" Suffix="h" />
    <converters:FlexibleDecimalConverter x:Key="HoursNullableConverter" Format="N2" Suffix="h" AllowNull="True" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock FontSize="16"
               FontWeight="SemiBold"
               TextWrapping="Wrap"
               Text="{Binding HeaderText}" />

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Margin="0,12,0,8"
                Visibility="{Binding IsCasePage, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="Akte:" FontWeight="SemiBold" />
      <TextBlock Text="{Binding CurrentCase.FileRef}" Margin="6,0,16,0" />
      <TextBlock Text="Abrechnung:" FontWeight="SemiBold" />
      <TextBlock Text="{Binding CurrentCase.BillingType}" Margin="6,0,16,0" />
      <TextBlock Text="Status:" FontWeight="SemiBold" />
      <TextBlock Text="{Binding CurrentCase.ApprovalStatusText}" Margin="6,0,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="2"
                Margin="0,0,0,8">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsCasePage}" Value="True" />
                <Condition Binding="{Binding CurrentCase.IsRvgBilling}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <TextBlock Text="RVG-Status:" FontWeight="SemiBold" />
      <TextBlock Text="{Binding CurrentCase.RvgStatusText}" TextWrapping="Wrap" />
      <CheckBox Content="Differenz abrechnen"
                Margin="0,6,0,0"
                IsChecked="{Binding CurrentCase.IsRvgDifferenceEnabled}"
                Visibility="{Binding CurrentCase.CanToggleRvgDifference, Converter={StaticResource BoolToVis}}" />
    </StackPanel>

    <StackPanel Grid.Row="3"
                Margin="0,0,0,8">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSummaryPage}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <TextBlock Text="Zusammenfassung" FontWeight="SemiBold" FontSize="14" />
      <Border BorderBrush="LightGray" BorderThickness="1" Padding="12" Margin="0,8,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Akten gesamt" FontWeight="SemiBold" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SummaryCaseCount}" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Summe Hourly" FontWeight="SemiBold" Margin="0,6,0,0" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SummaryHourlyTotal, Converter={StaticResource CurrencyConverter}}" Margin="0,6,0,0" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Summe RVG" FontWeight="SemiBold" Margin="0,6,0,0" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SummaryRvgTotal, Converter={StaticResource CurrencyConverter}}" Margin="0,6,0,0" />
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Gesamt" FontWeight="SemiBold" Margin="0,6,0,0" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SummaryGrandTotal, Converter={StaticResource CurrencyConverter}}" Margin="0,6,0,0" />
        </Grid>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="3"
                Margin="0,0,0,8"
                Visibility="{Binding IsCasePage, Converter={StaticResource BoolToVis}}">
      <StackPanel Margin="0,0,0,8">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsCasePage}" Value="True" />
                  <Condition Binding="{Binding CurrentCase.IsRvgBilling}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Text="RVG-Aufschlüsselung" FontWeight="SemiBold" />
        <Border BorderBrush="LightGray" BorderThickness="1" Padding="8" Margin="0,6,0,0">
          <StackPanel>
            <DataGrid ItemsSource="{Binding CurrentCase.RvgBreakdownItems}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      Margin="0,0,0,6"
                      Visibility="{Binding CurrentCase.HasRvgBreakdown, Converter={StaticResource BoolToVis}}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Gebühr" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Faktor" Binding="{Binding Factor, StringFormat=N2}" Width="90" />
                <DataGridTextColumn Header="Basis (1,0)" Binding="{Binding BaseFee, Converter={StaticResource CurrencyConverter}}" Width="120" />
                <DataGridTextColumn Header="Betrag" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" Width="120" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding CurrentCase.RvgBreakdownNote, StringFormat=({0})}"
                       Foreground="DimGray"
                       Margin="0,0,0,6"
                       Visibility="{Binding CurrentCase.HasRvgBreakdownNote, Converter={StaticResource BoolToVis}}" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding CurrentCase.HasRvgBreakdown, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="Summe" FontWeight="SemiBold" Margin="0,0,8,0" />
              <TextBlock Text="{Binding CurrentCase.RvgBreakdownTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <DataGrid ItemsSource="{Binding CurrentCase.TimeEntries}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Datum" Binding="{Binding StartLocal, StringFormat=dd.MM.yyyy}" Width="140" />
          <DataGridTextColumn Header="Dauer" Binding="{Binding DurationText}" Width="100" />
          <DataGridTextColumn Header="Notiz" Binding="{Binding Note}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>

    <StackPanel Grid.Row="4"
                Margin="0,0,0,8">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsCasePage}" Value="True" />
                <Condition Binding="{Binding CurrentCase.IsHourlyBilling}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <TextBlock Text="Dummy/Nachtrag (nur Stundenabrechnung)" FontWeight="SemiBold" />
      <Border BorderBrush="LightGray" BorderThickness="1" Padding="8" Margin="0,6,0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding CurrentCase.DummyRowLabel}" FontWeight="SemiBold" Foreground="DarkSlateBlue" />
          <TextBlock Grid.Column="1"
                     Text="{Binding CurrentCase.DummyDurationText}"
                     FontWeight="SemiBold" />
          <TextBlock Grid.Column="2"
                     Text="{Binding CurrentCase.DummyRowNote}"
                     TextWrapping="Wrap" />
        </Grid>
      </Border>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="160" />
          <ColumnDefinition Width="240" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="160" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Dummy-Stunden" VerticalAlignment="Center" />
        <TextBox Grid.Row="0"
                 Grid.Column="1"
                 Text="{Binding CurrentCase.DummyHours, Converter={StaticResource HoursConverter}, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding CurrentCase.IsDummyHoursEditable}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Dummy-Grund" VerticalAlignment="Top" Margin="0,6,0,0" />
        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Grid.ColumnSpan="4"
                 Height="48"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Margin="0,6,0,0"
                 Text="{Binding CurrentCase.DummyReason, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Zielsumme (optional)" VerticalAlignment="Center" Margin="0,6,0,0" />
        <TextBox Grid.Row="2"
                 Grid.Column="1"
                 Margin="0,6,0,0"
                 Text="{Binding CurrentCase.TargetTotalHours, Converter={StaticResource HoursNullableConverter}, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="2"
                   Grid.Column="3"
                   Grid.ColumnSpan="2"
                   Margin="0,6,0,0"
                   Text="Wenn gesetzt, überschreibt es die Gesamtsumme; Dummy wird automatisch als Differenz berechnet."
                   TextWrapping="Wrap"
                   Foreground="DimGray" />
      </Grid>
    </StackPanel>

    <Grid Grid.Row="5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Visibility="{Binding IsCasePage, Converter={StaticResource BoolToVis}}">
        <StackPanel Margin="0,0,24,0">
          <TextBlock Text="Tracked Minuten" FontSize="11" Foreground="DimGray" />
          <TextBlock Text="{Binding CurrentCase.TrackedMinutes}" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Margin="0,0,24,0">
          <TextBlock Text="Tracked Betrag" FontSize="11" Foreground="DimGray" />
          <TextBlock Text="{Binding CurrentCase.TrackedAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Margin="0,0,24,0" Visibility="{Binding CurrentCase.ShowRvgTotal, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="RVG Gesamt" FontSize="11" Foreground="DimGray" />
          <TextBlock Text="{Binding CurrentCase.RvgTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Margin="0,0,24,0" Visibility="{Binding CurrentCase.IsHourlyBilling, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="Dummy Minuten" FontSize="11" Foreground="DimGray" />
          <TextBlock Text="{Binding CurrentCase.DummyMinutes}" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Margin="0,0,24,0" Visibility="{Binding CurrentCase.IsHourlyBilling, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="Dummy Betrag" FontSize="11" Foreground="DimGray" />
          <TextBlock Text="{Binding CurrentCase.DummyAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Margin="0,0,24,0">
          <TextBlock Text="Gesamt Minuten" FontSize="11" Foreground="DimGray" />
          <TextBlock Text="{Binding CurrentCase.TotalMinutes}" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Gesamt Betrag" FontSize="11" Foreground="DimGray" />
          <TextBlock Text="{Binding CurrentCase.TotalAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Zurück" Width="90" Command="{Binding PrevCommand}" Margin="0,0,8,0" />
        <Button Content="Speichern"
                Width="90"
                Command="{Binding SaveCurrentCaseCommand}"
                Margin="0,0,8,0"
                Visibility="{Binding IsCasePage, Converter={StaticResource BoolToVis}}" />
        <Button Content="Freigeben"
                Width="90"
                Command="{Binding ApproveCurrentCaseCommand}"
                Margin="0,0,8,0"
                Visibility="{Binding IsCasePage, Converter={StaticResource BoolToVis}}" />
        <Button Content="Weiter"
                Width="90"
                Command="{Binding NextCommand}"
                Margin="0,0,8,0"
                Visibility="{Binding IsCasePage, Converter={StaticResource BoolToVis}}" />
        <Button Content="PDF speichern…"
                Width="120"
                Command="{Binding ExportCommand}"
                Margin="0,0,8,0"
                Visibility="{Binding IsSummaryPage, Converter={StaticResource BoolToVis}}" />
        <Button Content="Schließen" Width="90" Click="OnClose" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
