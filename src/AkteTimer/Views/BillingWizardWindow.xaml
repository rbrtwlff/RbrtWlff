<Window x:Class="AkteTimer.Views.BillingWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Abrechnung" Height="240" Width="420">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="BatchText"
               FontSize="14"
               FontWeight="SemiBold"
               TextWrapping="Wrap" />
    <TextBlock Grid.Row="1"
               Margin="0,12,0,0"
               TextWrapping="Wrap"
               Text="Der Abrechnungsentwurf wurde erstellt. Bitte schließen Sie dieses Fenster, um fortzufahren." />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Schließen" Width="90" Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>
