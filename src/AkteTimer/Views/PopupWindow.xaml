<Window x:Class="AkteTimer.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zeiterfassung"
        Width="420" Height="720"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  </Window.Resources>
  <Border Padding="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid FocusManager.FocusedElement="{Binding ElementName=FileRefBox}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Zeiterfassung" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Willkommen zurück" Style="{StaticResource SubtitleTextStyle}" Margin="0,6,0,0" />
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource StatusChipStyle}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse Style="{StaticResource StatusChipDotStyle}" VerticalAlignment="Center" />
              <TextBlock Style="{StaticResource StatusChipTextStyle}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="AKTUELLE AKTE" Style="{StaticResource OverlineTextStyle}" />
            <TextBlock Text="{Binding ActiveMatterText}" Style="{StaticResource LargeValueTextStyle}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Aktenzeichen" Style="{StaticResource CardTitleTextStyle}" />
            <TextBox x:Name="FileRefBox"
                     KeyboardNavigation.TabIndex="0"
                     ToolTip="z.B. 1234/25"
                     Text="{Binding FileRefInput, UpdateSourceTrigger=PropertyChanged}">
              <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFileRefInvalid}" Value="True">
                      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                      <Setter Property="BorderThickness" Value="1.5" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBox.Style>
            </TextBox>
            <TextBlock Text="{Binding FileRefValidationMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="12"
                       Margin="0,4,0,0"
                       Visibility="{Binding IsFileRefInvalid, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="Enter bestätigt und startet sofort." Style="{StaticResource HintTextStyle}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Aktuelle Sitzung" Style="{StaticResource CardTitleTextStyle}" />
            <TextBlock Text="{Binding EntryDurationText}" Style="{StaticResource TimerTextStyle}" Margin="0,10,0,0" />
            <Border Background="#FFF3F4F6" CornerRadius="999" Padding="10,4" HorizontalAlignment="Left" Margin="0,8,0,0">
              <TextBlock>
                <Run Text="Heute: " />
                <Run Text="{Binding TodayDurationText, Mode=OneWay}" />
              </TextBlock>
            </Border>
          </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0"
                  Style="{StaticResource PrimaryActionButtonStyle}"
                  Margin="0,0,12,0"
                  Command="{Binding ToggleCommand}"
                  KeyboardNavigation.TabIndex="1"
                  IsEnabled="{Binding CanStart}">
            <StackPanel HorizontalAlignment="Center">
              <Border Width="36" Height="36" CornerRadius="18" Background="#33FFFFFF" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconPlay}" Fill="White" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Start" Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1"
                  Style="{StaticResource SecondaryActionButtonStyle}"
                  Margin="0,0,12,0"
                  Command="{Binding ToggleCommand}"
                  KeyboardNavigation.TabIndex="2"
                  IsEnabled="{Binding CanPause}">
            <StackPanel HorizontalAlignment="Center">
              <Border Width="36" Height="36" CornerRadius="18" Background="#FFE5E7EB" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconPause}" Fill="{StaticResource TextPrimaryBrush}" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Pause" Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2"
                  Style="{StaticResource DangerActionButtonStyle}"
                  Click="StopButton_Click"
                  KeyboardNavigation.TabIndex="3"
                  IsEnabled="{Binding CanStop}">
            <StackPanel HorizontalAlignment="Center">
              <Border Width="36" Height="36" CornerRadius="18" Background="#33FFFFFF" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconStop}" Fill="White" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Stopp" Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>

        <Border Grid.Row="5" Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="TÄTIGKEIT AUSWÄHLEN" Style="{StaticResource OverlineTextStyle}" />
            <ItemsControl ItemsSource="{Binding HashtagOptions}" Margin="0,12,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource ChipButtonStyle}"
                          Command="{Binding DataContext.SelectHashtagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          KeyboardNavigation.TabIndex="4"
                          ToolTip="{Binding Hotkey}">
                    <TextBlock Text="{Binding Text}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource CardStyle}" Margin="0">
          <StackPanel>
            <CheckBox Content="Hotkey-Hilfe" IsChecked="{Binding IsHotkeyHelpVisible}" KeyboardNavigation.TabIndex="7" />
            <Border Margin="0,10,0,0"
                    Padding="10"
                    Background="#FFF9FAFB"
                    CornerRadius="12"
                    Visibility="{Binding IsHotkeyHelpVisible, Converter={StaticResource BoolToVisibilityConverter}}">
              <StackPanel>
                <TextBlock Text="Ctrl+Alt+T: Popup öffnen" />
                <TextBlock Text="Enter: Aktenzeichen bestätigen / Start-Pause" />
                <TextBlock Text="Pfeil hoch/runter: letzte Akten" />
                <TextBlock Text="Ctrl+1..7: Hashtags setzen, Ctrl+0: #Sonstiges" />
                <TextBlock Text="Esc: Popup schließen" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </Border>
</Window>
