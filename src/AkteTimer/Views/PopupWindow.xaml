<Window x:Class="AkteTimer.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Zeiterfassung"
        Width="520" Height="760"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FFF4F5F7"
        FontFamily="Segoe UI">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <Style x:Key="TrackerCardStyle" TargetType="materialDesign:Card">
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,16" />
      <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
    </Style>

    <Style x:Key="TrackerHeaderTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
    </Style>

    <Style x:Key="TrackerSubtitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
    </Style>

    <Style x:Key="TrackerOverline" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="TrackerValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
    </Style>

    <Style x:Key="TrackerTimer" TargetType="TextBlock">
      <Setter Property="FontSize" Value="60" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
    </Style>

    <Style x:Key="TrackerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
      <Setter Property="Height" Value="86" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <Style x:Key="TrackerSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
      <Setter Property="Height" Value="86" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <Style x:Key="TrackerDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
      <Setter Property="Height" Value="86" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="#FFD32F2F" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="TrackerStatusChipStyle" TargetType="materialDesign:Chip">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Background" Value="#FFE5E7EB" />
      <Setter Property="BorderBrush" Value="#FFD1D5DB" />
      <Setter Property="Foreground" Value="#FF374151" />
      <Setter Property="BorderThickness" Value="1" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StateText}" Value="Running">
          <Setter Property="Background" Value="#FFE8F5E9" />
          <Setter Property="BorderBrush" Value="#FFB7E1C1" />
          <Setter Property="Foreground" Value="#FF137A3E" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StateText}" Value="Paused">
          <Setter Property="Background" Value="#FFFFF7E6" />
          <Setter Property="BorderBrush" Value="#FFF6D38B" />
          <Setter Property="Foreground" Value="#FF8A5B00" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TrackerChipStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignChip}">
      <Setter Property="Margin" Value="0,0,8,8" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
          <Setter Property="Foreground" Value="White" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Border Padding="20">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid FocusManager.FocusedElement="{Binding ElementName=FileRefBox}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Style="{StaticResource TrackerCardStyle}" Padding="20">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Zeiterfassung" Style="{StaticResource TrackerHeaderTitle}" />
              <TextBlock Text="Willkommen zurück" Style="{StaticResource TrackerSubtitle}" Margin="0,6,0,0" />
            </StackPanel>
            <materialDesign:Chip Grid.Column="1"
                                 Style="{StaticResource TrackerStatusChipStyle}"
                                 VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="8"
                         Height="8"
                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=materialDesign:Chip}}"
                         VerticalAlignment="Center" />
                <TextBlock Margin="8,0,0,0"
                           FontWeight="Bold"
                           FontSize="11">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="IDLE" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding StateText}" Value="Running">
                          <Setter Property="Text" Value="RUNNING" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StateText}" Value="Paused">
                          <Setter Property="Text" Value="PAUSED" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </materialDesign:Chip>
          </Grid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1" Style="{StaticResource TrackerCardStyle}">
          <StackPanel>
            <TextBlock Text="AKTUELLE AKTE" Style="{StaticResource TrackerOverline}" />
            <TextBlock Text="{Binding ActiveMatterText}"
                       Style="{StaticResource TrackerValue}"
                       Margin="0,6,0,0" />
          </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="2" Style="{StaticResource TrackerCardStyle}">
          <StackPanel>
            <TextBox x:Name="FileRefBox"
                     KeyboardNavigation.TabIndex="0"
                     Text="{Binding FileRefInput, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Aktenzeichen"
                     materialDesign:HintAssist.HelperText="Enter bestätigt und startet sofort.">
              <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFileRefInvalid}" Value="True">
                      <Setter Property="BorderBrush" Value="#FFD32F2F" />
                      <Setter Property="materialDesign:HintAssist.Foreground" Value="#FFD32F2F" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBox.Style>
            </TextBox>
            <TextBlock Text="{Binding FileRefValidationMessage}"
                       Foreground="#FFD32F2F"
                       FontSize="12"
                       Margin="0,6,0,0"
                       Visibility="{Binding IsFileRefInvalid, Converter={StaticResource BoolToVisibilityConverter}}" />
          </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="3" Style="{StaticResource TrackerCardStyle}">
          <StackPanel>
            <TextBlock Text="Timer" Style="{StaticResource TrackerOverline}" />
            <TextBlock Text="{Binding EntryDurationText}"
                       Style="{StaticResource TrackerTimer}"
                       Margin="0,10,0,0" />
            <materialDesign:Chip Margin="0,10,0,0"
                                 Padding="10,4"
                                 Background="#FFF1F5F9"
                                 BorderBrush="#FFE2E8F0">
              <TextBlock Text="{Binding TodayDurationText, StringFormat=Heute: {0}}" />
            </materialDesign:Chip>
          </StackPanel>
        </materialDesign:Card>

        <Grid Grid.Row="4" Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0"
                  Style="{StaticResource TrackerActionButtonStyle}"
                  Command="{Binding ToggleCommand}"
                  KeyboardNavigation.TabIndex="1"
                  IsEnabled="{Binding CanStart}">
            <StackPanel HorizontalAlignment="Center">
              <materialDesign:PackIcon Kind="Play" Width="24" Height="24" />
              <TextBlock Text="Start" Margin="0,8,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1"
                  Style="{StaticResource TrackerSecondaryButtonStyle}"
                  Command="{Binding ToggleCommand}"
                  KeyboardNavigation.TabIndex="2"
                  IsEnabled="{Binding CanPause}">
            <StackPanel HorizontalAlignment="Center">
              <materialDesign:PackIcon Kind="Pause" Width="24" Height="24" />
              <TextBlock Text="Pause" Margin="0,8,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2"
                  Style="{StaticResource TrackerDangerButtonStyle}"
                  Click="StopButton_Click"
                  KeyboardNavigation.TabIndex="3"
                  IsEnabled="{Binding CanStop}">
            <StackPanel HorizontalAlignment="Center">
              <materialDesign:PackIcon Kind="Stop" Width="24" Height="24" />
              <TextBlock Text="Stopp" Margin="0,8,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>

        <materialDesign:Card Grid.Row="5" Style="{StaticResource TrackerCardStyle}">
          <StackPanel>
            <TextBlock Text="TÄTIGKEIT AUSWÄHLEN" Style="{StaticResource TrackerOverline}" />
            <ItemsControl ItemsSource="{Binding HashtagOptions}" Margin="0,12,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource TrackerChipStyle}"
                          Command="{Binding DataContext.SelectHashtagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          KeyboardNavigation.TabIndex="4"
                          ToolTip="{Binding Hotkey}">
                    <TextBlock Text="{Binding Text}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="6" Style="{StaticResource TrackerCardStyle}" Margin="0">
          <StackPanel>
            <CheckBox Content="Hotkey-Hilfe"
                      IsChecked="{Binding IsHotkeyHelpVisible}"
                      KeyboardNavigation.TabIndex="7" />
            <Border Margin="0,10,0,0"
                    Padding="10"
                    Background="#FFF9FAFB"
                    CornerRadius="12"
                    Visibility="{Binding IsHotkeyHelpVisible, Converter={StaticResource BoolToVisibilityConverter}}">
              <StackPanel>
                <TextBlock Text="Ctrl+Alt+T: Popup öffnen" />
                <TextBlock Text="Enter: Aktenzeichen bestätigen / Start-Pause" />
                <TextBlock Text="Pfeil hoch/runter: letzte Akten" />
                <TextBlock Text="Ctrl+1..7: Hashtags setzen, Ctrl+0: #Sonstiges" />
                <TextBlock Text="Esc: Popup schließen" />
              </StackPanel>
            </Border>
          </StackPanel>
        </materialDesign:Card>
      </Grid>
    </ScrollViewer>
  </Border>
</Window>
