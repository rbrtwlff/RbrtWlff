<Window x:Class="AkteTimer.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zeiterfassung"
        Width="420" Height="720"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#F5F6FA"
        FontFamily="Segoe UI">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderBrush" Value="#E3E6EE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.1" />
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StatusBadgeStyle" TargetType="Border">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="#FFE5E7EB" />
      <Setter Property="BorderBrush" Value="#FFD1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StateText}" Value="Running">
          <Setter Property="Background" Value="#FFE8F5E9" />
          <Setter Property="BorderBrush" Value="#FFB7E1C1" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StateText}" Value="Paused">
          <Setter Property="Background" Value="#FFFFF7E6" />
          <Setter Property="BorderBrush" Value="#FFF6D38B" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="HashtagChipStyle" TargetType="Button">
      <Setter Property="Background" Value="#EEF2FF" />
      <Setter Property="BorderBrush" Value="#C7D2FE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#1E3A8A" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="#2563EB" />
          <Setter Property="BorderBrush" Value="#1D4ED8" />
          <Setter Property="Foreground" Value="White" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ValidatedTextBoxStyle" TargetType="TextBox">
      <Setter Property="Height" Value="36" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Margin" Value="0,6,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsFileRefInvalid}" Value="True">
          <Setter Property="BorderBrush" Value="#FFE53935" />
          <Setter Property="BorderThickness" Value="1.5" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="BorderBrush" Value="#1D4ED8" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#F3F4F6" />
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#DC2626" />
      <Setter Property="BorderBrush" Value="#B91C1C" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Resources>
  <Border Padding="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardStyle}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Zeiterfassung" FontSize="20" FontWeight="Bold" />
            <Border Style="{StaticResource StatusBadgeStyle}" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" FontSize="12" />
            </Border>
          </StackPanel>
          <TextBlock Text="Aktuelle Akte" FontSize="12" Foreground="#6B7280" Margin="0,10,0,0" />
          <TextBlock Text="{Binding ActiveMatterText}" FontSize="14" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#6B7280" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="Aktenzeichen" FontSize="13" FontWeight="SemiBold" />
          <TextBox x:Name="FileRefBox"
                   Style="{StaticResource ValidatedTextBoxStyle}"
                   KeyboardNavigation.TabIndex="0"
                   ToolTip="z.B. 1234/25"
                   Text="{Binding FileRefInput, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="{Binding FileRefValidationMessage}"
                     Foreground="#E53935"
                     FontSize="12"
                     Margin="0,4,0,0"
                     Visibility="{Binding IsFileRefInvalid, Converter={StaticResource BoolToVisibilityConverter}}" />
          <TextBlock Text="Enter bestätigt und startet sofort." FontSize="11" Foreground="#6B7280" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="Timer" FontSize="13" FontWeight="SemiBold" />
          <TextBlock Text="{Binding EntryDurationText}" FontSize="44" FontWeight="Bold" Margin="0,8,0,0" />
          <TextBlock Text="Heute: {Binding TodayDurationText}" FontSize="13" Foreground="#6B7280" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Style="{StaticResource PrimaryButtonStyle}"
                    Width="110"
                    Height="40"
                    Margin="0,0,8,0"
                    Command="{Binding ToggleCommand}"
                    KeyboardNavigation.TabIndex="1"
                    IsEnabled="{Binding CanStart}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="14" Margin="0,0,6,0" />
                <TextBlock Text="Start" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource SecondaryButtonStyle}"
                    Width="110"
                    Height="40"
                    Margin="0,0,8,0"
                    Command="{Binding ToggleCommand}"
                    KeyboardNavigation.TabIndex="2"
                    IsEnabled="{Binding CanPause}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="14" Margin="0,0,6,0" />
                <TextBlock Text="Pause" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource DangerButtonStyle}"
                    Width="130"
                    Height="40"
                    Click="StopButton_Click"
                    KeyboardNavigation.TabIndex="3"
                    IsEnabled="{Binding CanStop}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="14" Margin="0,0,6,0" />
                <TextBlock Text="Stop &amp; Speichern" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="3" Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="Tätigkeit auswählen" FontSize="13" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding HashtagOptions}" Margin="0,12,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource HashtagChipStyle}"
                        Command="{Binding DataContext.SelectHashtagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        KeyboardNavigation.TabIndex="4"
                        ToolTip="{Binding Hotkey}">
                  <TextBlock Text="{Binding Text}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Grid.Row="4" Style="{StaticResource CardStyle}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Letzte Einträge" FontSize="13" FontWeight="SemiBold" />
            <Button Style="{StaticResource SecondaryButtonStyle}"
                    Height="28"
                    Margin="12,0,0,0"
                    Padding="10,2"
                    KeyboardNavigation.TabIndex="6"
                    Click="ShowToday_Click">
              <TextBlock Text="Alle sehen" FontSize="12" />
            </Button>
          </StackPanel>
          <ListBox x:Name="RecentEntriesListBox"
                   ItemsSource="{Binding RecentEntries}"
                   SelectedItem="{Binding SelectedRecentEntry, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0"
                   KeyboardNavigation.TabIndex="5"
                   Margin="0,12,0,0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="10" CornerRadius="12" Background="#F9FAFB" Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding MatterFileRef}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Hashtag}" FontSize="12" Foreground="#6B7280" />
                      <TextBlock Text="{Binding StartedText}" FontSize="12" Foreground="#9CA3AF" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding DurationText}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <Border Grid.Row="5" Style="{StaticResource CardStyle}" Margin="0">
        <StackPanel>
          <CheckBox Content="Hotkey-Hilfe" IsChecked="{Binding IsHotkeyHelpVisible}" KeyboardNavigation.TabIndex="7" />
          <Border Margin="0,10,0,0"
                  Padding="10"
                  Background="#F9FAFB"
                  CornerRadius="12"
                  Visibility="{Binding IsHotkeyHelpVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Text="Ctrl+Alt+T: Popup öffnen" />
              <TextBlock Text="Enter: Aktenzeichen bestätigen / Start-Pause" />
              <TextBlock Text="Pfeil hoch/runter: letzte Akten" />
              <TextBlock Text="Ctrl+1..7: Hashtags setzen, Ctrl+0: #Sonstiges" />
              <TextBlock Text="Esc: Popup schließen" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
