<Window x:Class="AkteTimer.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zeiterfassung"
        Width="420"
        SizeToContent="Height"
        MaxHeight="{x:Static SystemParameters.WorkAreaHeight}"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <Style x:Key="CardBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" />
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PillBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="#EEF2F7" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="BorderBrush" Value="#D8DDE6" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="ActionButtonBaseStyle" TargetType="Button">
      <Setter Property="Height" Value="104" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="18"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
      <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
      <Setter Property="Background" Value="{StaticResource NeutralBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource NeutralDarkBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="PauseActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
      <Setter Property="Background" Value="#60A5FA" />
      <Setter Property="BorderBrush" Value="#3B82F6" />
      <Setter Property="Foreground" Value="White" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#3B82F6" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#2563EB" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
      <Setter Property="Background" Value="{StaticResource DangerBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerDarkBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="HashtagPillToggleStyle" TargetType="ToggleButton">
      <Setter Property="Background" Value="#EEF2F7" />
      <Setter Property="Foreground" Value="#1E293B" />
      <Setter Property="BorderBrush" Value="#D8DDE6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="20,10" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="18"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#E2E8F0" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#2563EB" />
                <Setter TargetName="Root" Property="BorderBrush" Value="#2563EB" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StatusChipBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="#EEF2F7" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style x:Key="StatusChipDotStyle" TargetType="Border">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="{StaticResource ChipIdleDotBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StateText}" Value="Running">
          <Setter Property="Background" Value="{StaticResource ChipRunningDotBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StateText}" Value="Paused">
          <Setter Property="Background" Value="{StaticResource ChipPausedDotBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StatusChipTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Text" Value="IDLE" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StateText}" Value="Running">
          <Setter Property="Text" Value="RUNNING" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StateText}" Value="Paused">
          <Setter Property="Text" Value="PAUSED" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Border Padding="16">
    <Grid FocusManager.FocusedElement="{Binding ElementName=FileRefBox}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="AKTUELLE AKTE" Style="{StaticResource OverlineTextStyle}" />
              <TextBlock Text="{Binding ActiveMatterText}" Style="{StaticResource LargeValueTextStyle}" Margin="0,6,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource StatusChipBorderStyle}" VerticalAlignment="Top" HorizontalAlignment="Right">
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource StatusChipDotStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Style="{StaticResource StatusChipTextStyle}" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
          <StackPanel>
            <TextBlock Text="Aktenzeichen" Style="{StaticResource CardTitleTextStyle}" />
            <TextBox x:Name="FileRefBox"
                     KeyboardNavigation.TabIndex="0"
                     ToolTip="z.B. 1234/25"
                     Text="{Binding FileRefInput, UpdateSourceTrigger=PropertyChanged}">
              <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFileRefInvalid}" Value="True">
                      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                      <Setter Property="BorderThickness" Value="1.5" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBox.Style>
            </TextBox>
            <TextBlock Text="{Binding FileRefValidationMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="12"
                       Margin="0,4,0,0"
                       Visibility="{Binding IsFileRefInvalid, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="Enter bestätigt und startet sofort." Style="{StaticResource HintTextStyle}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
          <StackPanel>
            <TextBlock Text="Aktuelle Sitzung" Style="{StaticResource CardTitleTextStyle}" />
            <TextBlock Text="{Binding EntryDurationText}" Style="{StaticResource TimerTextStyle}" Margin="0,10,0,0" HorizontalAlignment="Center" />
            <Border Style="{StaticResource PillBorderStyle}" HorizontalAlignment="Left" Margin="0,12,0,0">
              <TextBlock>
                <Run Text="Heute: " />
                <Run Text="{Binding TodayDurationText, Mode=OneWay}" />
              </TextBlock>
            </Border>
          </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0"
                  Style="{StaticResource PrimaryActionButtonStyle}"
                  Margin="0,0,12,0"
                  Command="{Binding ToggleCommand}"
                  KeyboardNavigation.TabIndex="1"
                  IsEnabled="{Binding CanStart}">
            <StackPanel HorizontalAlignment="Center">
              <Border Width="40" Height="40" CornerRadius="10" Background="#33FFFFFF" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconPlay}" Fill="White" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Start" Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1"
                  Style="{StaticResource PauseActionButtonStyle}"
                  Margin="0,0,12,0"
                  Command="{Binding ToggleCommand}"
                  KeyboardNavigation.TabIndex="2"
                  IsEnabled="{Binding CanPause}">
            <StackPanel HorizontalAlignment="Center">
              <Border Width="40" Height="40" CornerRadius="10" Background="#93C5FD" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconPause}" Fill="White" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Pause" Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2"
                  Style="{StaticResource DangerActionButtonStyle}"
                  Click="StopButton_Click"
                  KeyboardNavigation.TabIndex="3"
                  IsEnabled="{Binding CanStop}">
            <StackPanel HorizontalAlignment="Center">
              <Border Width="40" Height="40" CornerRadius="10" Background="#33FFFFFF" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconStop}" Fill="White" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Stopp" Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}">
          <StackPanel>
            <TextBlock Text="TÄTIGKEIT AUSWÄHLEN" Style="{StaticResource OverlineTextStyle}" />
            <ItemsControl ItemsSource="{Binding HashtagOptions}" Margin="0,12,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ToggleButton Style="{StaticResource HashtagPillToggleStyle}"
                          Command="{Binding DataContext.SelectHashtagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          KeyboardNavigation.TabIndex="4"
                          ToolTip="{Binding Hotkey}"
                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                          Content="{Binding Text}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      <Border Grid.Row="5" Style="{StaticResource CardBorderStyle}" Margin="0">
        <StackPanel>
          <CheckBox Content="Hotkey-Hilfe" IsChecked="{Binding IsHotkeyHelpVisible}" KeyboardNavigation.TabIndex="7" />
          <Border Margin="0,10,0,0"
                  Padding="10"
                  Background="#FFF9FAFB"
                  CornerRadius="12"
                  Visibility="{Binding IsHotkeyHelpVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Text="Ctrl+Alt+T: Popup öffnen" />
              <TextBlock Text="Enter: Aktenzeichen bestätigen / Start-Pause" />
              <TextBlock Text="Pfeil hoch/runter: letzte Akten" />
              <TextBlock Text="Ctrl+1..7: Hashtags setzen, Ctrl+0: #Sonstiges" />
              <TextBlock Text="Esc: Popup schließen" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
