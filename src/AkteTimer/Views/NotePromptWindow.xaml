<Window x:Class="AkteTimer.Views.NotePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kurzbeschreibung"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="True">
  <Border Padding="16">
    <StackPanel>
      <TextBlock Text="Kurzbeschreibung" FontWeight="Bold" FontSize="14" />
      <TextBox x:Name="NoteBox"
               Width="320"
               Margin="0,8,0,6"
               MaxLength="200" />
      <TextBlock Text="Enter = Speichern, Enter bei leer = Überspringen"
                 Foreground="Gray"
                 FontSize="11" />
    </StackPanel>
  </Border>
</Window>
