<Window x:Class="AkteTimer.Views.TodayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Heute" Height="360" Width="640">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBlock FontWeight="Bold"
                 Text="{Binding TotalDuration, StringFormat=Summe Ist: {0}}" />
      <TextBlock FontWeight="Bold"
                 Text="{Binding TotalActualMinutes, StringFormat=Summe Ist-Minuten: {0}}" />
      <TextBlock FontWeight="Bold"
                 Text="{Binding TotalRoundedMinutes, StringFormat=Summe 6-Min: {0}}" />
    </StackPanel>
    <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Entries}" IsReadOnly="True" MouseDoubleClick="OnEntryDoubleClick">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Start" Binding="{Binding StartLocal, StringFormat=HH:mm:ss}" />
        <DataGridTextColumn Header="Ende" Binding="{Binding EndLocal, StringFormat=HH:mm:ss}" />
        <DataGridTextColumn Header="Akte" Binding="{Binding Matter}" />
        <DataGridTextColumn Header="Hashtag" Binding="{Binding Hashtag}" />
        <DataGridTextColumn Header="Dauer" Binding="{Binding DurationText}" />
        <DataGridTextColumn Header="Ist-Min" Binding="{Binding ActualMinutes}" />
        <DataGridTextColumn Header="6-Min" Binding="{Binding RoundedMinutes}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
