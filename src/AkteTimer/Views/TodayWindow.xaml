<Window x:Class="AkteTimer.Views.TodayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Heute" Height="360" Width="560">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontWeight="Bold" Text="{Binding TotalDuration, StringFormat=Summe: {0}}" />
    <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Entries}" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Start" Binding="{Binding StartLocal, StringFormat=HH:mm:ss}" />
        <DataGridTextColumn Header="Ende" Binding="{Binding EndLocal, StringFormat=HH:mm:ss}" />
        <DataGridTextColumn Header="Akte" Binding="{Binding Matter}" />
        <DataGridTextColumn Header="Dauer" Binding="{Binding DurationText}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
